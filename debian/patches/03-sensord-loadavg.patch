--- lm_sensors-3.1.1.orig/prog/sensord/rrd.c	2009-06-09 14:44:44.000000000 +0200
+++ lm_sensors-3.1.1/prog/sensord/rrd.c	2009-06-28 22:17:12.000000000 +0200
@@ -215,6 +215,10 @@
 			min = "-100";
 			max = "250";
 			break;
+		case DataType_loadavg:
+			min = "0";
+			max = "U";
+			break;
 		default:
 			min = max = "U";
 			break;
@@ -235,8 +239,11 @@
 	int ret = 0;
 	struct ds data = { 0, argv};
 	ret = applyToFeatures(rrdGetSensors_DS, &data);
-	if (!ret && sensord_args.doLoad)
-		ret = rrdGetSensors_DS(&data, LOADAVG, LOAD_AVERAGE, NULL);
+	if (!ret && sensord_args.doLoad) {
+		FeatureDescriptor feature;
+		feature.type = DataType_loadavg;
+		ret = rrdGetSensors_DS (&data, LOADAVG, LOAD_AVERAGE, &feature);
+	}
 	return ret ? -1 : data.num;
 }
 
